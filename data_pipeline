import os
import re
import sqlite3
import requests
from bs4 import BeautifulSoup
import pandas as pd

# Constants
BASE_URL = "http://books.toscrape.com/catalogue/"
START_URL = "http://books.toscrape.com/catalogue/page-1.html"
FIXED_GBP_TO_INR = 105.50
DB_FILE = "zepto_catalog.db"

RATING_MAP = {
    "One": 1, "Two": 2, "Three": 3, "Four": 4, "Five": 5
}

def scrape_books(target_count=60):
    books = []
    current_url = START_URL
    
    while current_url and len(books) < target_count:
        response = requests.get(current_url)
        if response.status_code != 200:
            break
        
        soup = BeautifulSoup(response.content, "html.parser")
        articles = soup.find_all("article", class_="product_pod")
        
        for article in articles:
            title = article.h3.a["title"]
            price_text = article.find("p", class_="price_color").text
            rating_text = article.p["class"][1]
            availability_text = article.find("p", class_="instock availability").text.strip()
            
            # Fetch book detail page to get category
            detail_rel_url = article.h3.a["href"]
            detail_url = BASE_URL + detail_rel_url if not detail_rel_url.startswith("catalogue/") else "http://books.toscrape.com/" + detail_rel_url
            
            cat_res = requests.get(detail_url)
            category = "General"
            if cat_res.status_code == 200:
                cat_soup = BeautifulSoup(cat_res.content, "html.parser")
                breadcrumb = cat_soup.find("ul", class_="breadcrumb")
                if breadcrumb:
                    lis = breadcrumb.find_all("li")
                    if len(lis) >= 3:
                        category = lis[2].text.strip()
            
            books.append({
                "title": title,
                "price_raw": price_text,
                "rating_raw": rating_text,
                "availability_raw": availability_text,
                "category": category
            })
            
            if len(books) >= target_count:
                break
                
        # Handle pagination
        next_li = soup.find("li", class_="next")
        if next_li and next_li.a:
            next_href = next_li.a["href"]
            current_url = BASE_URL + next_href if not next_href.startswith("catalogue/") else "http://books.toscrape.com/" + next_href
        else:
            current_url = None
            
    return pd.DataFrame(books)

def clean_data(df):
    cleaned = []
    
    # Pre-calc median for numerical fallback
    extracted_prices = df['price_raw'].str.extract(r'([\d\.]+)')[0].astype(float)
    median_price = extracted_prices.median()
    
    for _, row in df.iterrows():
        # 1. Clean Price
        try:
            val = float(re.search(r'[\d\.]+', row['price_raw']).group())
            price_gbp = val
        except Exception:
            price_gbp = median_price  # Median-imputation fallback strategy
            
        # 2. Convert GBP to INR (Fixed Rate = 105.50)
        price_inr = round(price_gbp * FIXED_GBP_TO_INR, 2)
        
        # 3. Clean Rating
        rating = RATING_MAP.get(row['rating_raw'], 3) # default to median 3
        
        # 4. Clean Availability
        in_stock = 1 if "in stock" in row['availability_raw'].lower() else 0
        
        cleaned.append({
            "title": row['title'],
            "price_gbp": price_gbp,
            "price_inr": price_inr,
            "rating": rating,
            "in_stock": in_stock,
            "category_name": row['category']
        })
        
    return pd.DataFrame(cleaned)

def build_database(df_clean, db_path=DB_FILE):
    if os.path.exists(db_path):
        os.remove(db_path)
        
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()
    
    # Create two normalized tables with PK/FK constraint
    cursor.execute("""
    CREATE TABLE categories (
        category_id INTEGER PRIMARY KEY AUTOINCREMENT,
        category_name TEXT UNIQUE NOT NULL
    );
    """)
    
    cursor.execute("""
    CREATE TABLE books (
        book_id INTEGER PRIMARY KEY AUTOINCREMENT,
        title TEXT NOT NULL,
        price_gbp REAL NOT NULL,
        price_inr REAL NOT NULL,
        rating INTEGER NOT NULL,
        in_stock INTEGER NOT NULL,
        category_id INTEGER,
        FOREIGN KEY (category_id) REFERENCES categories (category_id)
    );
    """)
    
    # Insert unique categories
    categories = df_clean['category_name'].unique()
    for cat in categories:
        cursor.execute("INSERT INTO categories (category_name) VALUES (?)", (cat,))
    conn.commit()
    
    # Load category mapping
    cat_df = pd.read_sql("SELECT category_id, category_name FROM categories", conn)
    cat_map = dict(zip(cat_df['category_name'], cat_df['category_id']))
    
    # Insert books
    books_data = []
    for _, row in df_clean.iterrows():
        books_data.append((
            row['title'],
            row['price_gbp'],
            row['price_inr'],
            row['rating'],
            row['in_stock'],
            cat_map[row['category_name']]
        ))
        
    cursor.executemany("""
    INSERT INTO books (title, price_gbp, price_inr, rating, in_stock, category_id)
    VALUES (?, ?, ?, ?, ?, ?)
    """, books_data)
    
    conn.commit()
    return conn

def execute_queries_and_validate(conn):
    cursor = conn.cursor()
    
    queries = {
        "Q1_SELECT_WHERE": "SELECT title, price_inr, rating FROM books WHERE rating >= 4;",
        "Q2_ORDER_BY_LIMIT": "SELECT title, price_gbp FROM books ORDER BY price_gbp DESC LIMIT 5;",
        "Q3_DISTINCT": "SELECT DISTINCT category_id FROM books;",
        "Q4_BETWEEN": "SELECT title, price_gbp FROM books WHERE price_gbp BETWEEN 20.0 AND 40.0;",
        "Q5_JOIN": """
            SELECT b.title, c.category_name, b.price_gbp, b.price_inr, b.rating 
            FROM books b 
            JOIN categories c ON b.category_id = c.category_id 
            WHERE b.rating = 5 
            ORDER BY b.price_gbp DESC 
            LIMIT 10;
        """
    }
    
    print("=== EXECUTING SQL QUERIES ===")
    results = {}
    for name, q in queries.items():
        print(f"\n--- {name} ---")
        df_res = pd.read_sql(q, conn)
        results[name] = df_res
        print(df_res.head())
        
    # Validation step: Reproduce Q5 JOIN using pure pandas pd.merge
    df_books = pd.read_sql("SELECT * FROM books", conn)
    df_cats = pd.read_sql("SELECT * FROM categories", conn)
    
    merged_pd = pd.merge(df_books, df_cats, on="category_id")
    merged_pd = merged_pd[merged_pd['rating'] == 5].sort_values(by="price_gbp", ascending=False).head(10)
    merged_pd = merged_pd[['title', 'category_name', 'price_gbp', 'price_inr', 'rating']].reset_index(drop=True)
    
    sql_join_res = results["Q5_JOIN"].reset_index(drop=True)
    
    print("\n=== PANDAS MERGE VALIDATION ===")
    print(merged_pd.head())
    
    assert pd.testing.assert_frame_equal(sql_join_res, merged_pd) is None
    print("\n[SUCCESS] SQL JOIN and Pandas pd.merge outputs match identically!")

if __name__ == "__main__":
    print("Scraping books.toscrape.com...")
    raw_df = scrape_books(target_count=60)
    print(f"Scraped {len(raw_df)} rows.")
    
    clean_df = clean_data(raw_df)
    conn = build_database(clean_df)
    execute_queries_and_validate(conn)
    conn.close()